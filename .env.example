# Copy this file to .env.local and fill in the values
# .env.local is git-ignored — never commit real keys

# Resend.io — used for contact form emails
RESEND_API_KEY=your_resend_api_key_here

# Public site URL — used in sitemap, OG tags, canonical links
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Energica Configurator backend API URL
NEXT_PUBLIC_CONFIGURATOR_API_URL=https://your-backend-url.com

# Energica ReCharge — email verification token signing secret (any long random string)
RECHARGE_VERIFY_SECRET=generate_a_long_random_string_here

# Energica ReCharge — Cloudflare Turnstile (spam protection on lead submission)
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
